# Шаблон файла окружения для systemd-юнитов room-bot.
#
# Скопируй на VM в /etc/room-bot.env со своими реальными значениями:
#   sudo cp deploy/room-bot.env.example /etc/room-bot.env
#   sudo nano /etc/room-bot.env
#   sudo chmod 600 /etc/room-bot.env
#
# Этот файл (с настоящими секретами) НЕ должен попасть в git —
# .gitignore уже исключает *.env, но держи его вне репозитория на VM тоже.

TG_BOT_TOKEN=твой_токен_бота
TG_MY_CHAT_ID=твой_chat_id
